# Copiare questo file con il nome ".env" nella STESSA cartella di docker-compose.qnap.yml e compilare i valori.
# Il file ".env" contiene segreti: non va mai aggiunto a git (e' gia' escluso da .gitignore).

# ── Indirizzo del NAS (quello che scrivi nel browser) ───────────────────────────
NAS_HOST=192.168.1.144
HTTP_PORT=3001
HTTPS_PORT=3443

# ── Quale versione dell'app: "dev" = ramo develop (quella con tutte le funzioni recenti) ──
IMAGE_TAG=dev

# ── Database sul NAS: un Postgres che viene COPIATO UNA VOLTA da quello di Render ───────────────────────────
# Dopo la copia i due database sono INDIPENDENTI: quello del NAS non si aggiorna da solo e le modifiche fatte sul NAS non tornano su Render.
# POSTGRES_PASSWORD: la password del database del NAS (la inventi tu, o la generi con: openssl rand -base64 24). Dopo il primo avvio NON cambiarla.
POSTGRES_PASSWORD=
# Cartella sul NAS dove Postgres tiene i dati: percorso ASSOLUTO. Va creata da File Station prima del primo avvio.
PG_DIR=/share/Container/mev/pgdata
# SOURCE_DATABASE_URL: il database di Render da cui copiare (Render -> servizio mev-governance-backend-dev -> Environment -> DATABASE_DIRECT_URL).
# Serve solo al primo avvio. Dopo, puoi anche svuotarla.
SOURCE_DATABASE_URL=
# Lo schema da copiare. Se su Render DB_SCHEMA e' diverso da "dev", metterlo qui.
DB_SCHEMA=dev
# once    = copia solo se il database del NAS e' ancora vuoto (default, sicuro: un riavvio non tocca mai i dati)
# skip    = non copia mai
# replace = CANCELLA i dati del NAS e li ricopia da Render (perde tutto cio' che e' stato fatto sul NAS dopo la prima copia)
IMPORT_MODE=once

# ── Autenticazione ──────────────────────────────────────────────────────────────
# JWT_KEY: una stringa lunga e casuale (almeno 32 caratteri). Cambiarla fa uscire tutti gli utenti (devono rifare il login).
# Generarla con:   openssl rand -base64 48
JWT_KEY=
# ATTENZIONE: a OGNI avvio il backend imposta la password dell'utente MSTEFANE a questo valore.
# Siccome il database e' lo stesso di Render, METTERE LA STESSA password che ha oggi su Render,
# altrimenti si cambia anche quella di Render. (Render: ADMIN_PASSWORD del backend dev.)
ADMIN_PASSWORD=

# ── Facoltativo ─────────────────────────────────────────────────────────────────
# Cartella sul NAS per i file caricati: percorso ASSOLUTO (da File Station deve esistere: /share/Container/mev/data)
DATA_DIR=/share/Container/mev/data
# Cartella con server.crt e server.key, se hai un certificato HTTPS vero. Se manca, ne viene generato uno autofirmato.
CERTS_DIR=/share/Container/mev/certs
